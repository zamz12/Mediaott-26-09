# ---------------------------------------------------------------------------
# LOKAL platform configuration. Copy to .env and fill in real values.
# Never commit .env. In production, source these from a secret manager
# (AWS Secrets Manager / SSM Parameter Store), not from a file on disk.
# ---------------------------------------------------------------------------

# App
NEXT_PUBLIC_APP_NAME="LOKAL"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# Database (PostgreSQL)
DATABASE_URL="postgresql://lokal:lokal_dev_password@localhost:5432/lokal?schema=public"

# Auth.js
AUTH_SECRET="replace-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"

# Redis (queue backend for background jobs)
REDIS_URL="redis://localhost:6379"

# Object storage — StorageProvider (S3-compatible)
# Local dev uses MinIO. Production points at AWS S3 in ap-southeast-5 (Malaysia).
STORAGE_PROVIDER="s3"
STORAGE_ENDPOINT="http://localhost:9000"
STORAGE_REGION="ap-southeast-5"
STORAGE_ACCESS_KEY_ID="lokal_minio"
STORAGE_SECRET_ACCESS_KEY="lokal_minio_secret"
STORAGE_FORCE_PATH_STYLE="true"
STORAGE_BUCKET_MASTERS="lokal-masters"
STORAGE_BUCKET_TRANSCODED="lokal-transcoded"
STORAGE_BUCKET_PREVIEWS="lokal-previews"
STORAGE_BUCKET_THUMBNAILS="lokal-thumbnails"
STORAGE_BUCKET_SUBTITLES="lokal-subtitles"
STORAGE_BUCKET_VAULT="lokal-private-vault"
STORAGE_BUCKET_TEMP="lokal-temporary"
STORAGE_SIGNED_URL_TTL_SECONDS="300"

# Transcode provider: "local-ffmpeg" (dev) | "aws-mediaconvert" (prod)
TRANSCODE_PROVIDER="local-ffmpeg"

# Transcription provider: "stub" (dev, no-op) | "aws-transcribe" (prod)
TRANSCRIPTION_PROVIDER="stub"

# Notification provider: "console" (dev, logs only) | "aws-ses-sns" (prod)
NOTIFICATION_PROVIDER="console"

# Payment provider: kept OFF for MVP. "noop" disables all billing UI/logic.
PAYMENT_PROVIDER="noop"
BILLING_ENABLED="false"

# Search provider: "postgres" (MVP full-text search) | future: "opensearch"
SEARCH_PROVIDER="postgres"

# Feature flags
FEATURE_LIVE_STREAMING="false"
FEATURE_AI_TRANSCRIPTION="false"
FEATURE_SUBSCRIPTIONS="false"
